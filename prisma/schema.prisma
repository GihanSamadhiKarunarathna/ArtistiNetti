// ArtistiNetti — v1.0 data model.
// See /Users/gihan/.claude/plans/shimmering-kindling-planet.md for the design rationale.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  ARTIST
  AGENT
  CLIENT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum AvailabilityType {
  CONFIRMED_GIG
  HOLD
  BLOCKED
  PENDING_QUOTE
}

enum InquiryStatus {
  AWAITING_ARTIST_CONFIRMATION
  NEW
  IN_REVIEW
  QUOTED
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

enum QuoteStatus {
  DRAFT
  AWAITING_ARTIST_APPROVAL
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  WITHDRAWN
}

enum EventType {
  WEDDING
  CORPORATE
  BAR_CLUB
  PRIVATE_PARTY
  FESTIVAL
  OTHER
}

enum SenderRole {
  CLIENT
  ARTIST
  AGENT
  ADMIN
  SYSTEM
}

enum PaymentProviderType {
  MOCK
  STRIPE
  PAYTRAIL
  MOBILEPAY
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  RELEASED
  REFUNDED
  FAILED
  CANCELLED
}

enum PaymentPurpose {
  DEPOSIT
  BALANCE
  FULL
  PAYOUT
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  emailVerified DateTime?
  phone         String?
  name          String?
  image         String?
  passwordHash  String?
  role          Role
  status        ApprovalStatus @default(PENDING)
  locale        String         @default("fi")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  accounts        Account[]
  sessions        Session[]
  artistProfile   ArtistProfile? @relation("UserArtistProfile")
  agentProfile    AgentProfile?
  clientProfile   ClientProfile?
  bandMemberships BandMember[]
  messagesSent    Message[]
  auditLogs       AuditLog[]

  @@index([role, status])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// A booking agency, always present as a tenant — including "agencies of one"
// auto-created for self-represented bands (isSelfManaged = true).
model Agency {
  id                   String   @id @default(cuid())
  name                 String
  businessId           String?  @unique
  isSelfManaged        Boolean  @default(false)
  defaultCommissionPct Decimal  @default(0) @db.Decimal(5, 2)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  staff       AgentProfile[]
  artists     ArtistProfile[] @relation("AgencyArtists")
  selfArtists ArtistProfile[] @relation("AgencySelfOwner")
  invites     AgencyInvite[]

  @@index([isSelfManaged])
}

model AgencyInvite {
  id              String    @id @default(cuid())
  agencyId        String
  agency          Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  email           String
  name            String?
  token           String    @unique
  invitedByUserId String
  acceptedAt      DateTime?
  expiresAt       DateTime
  createdAt       DateTime  @default(now())

  @@index([agencyId])
}

model AgentProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agencyId       String
  agency         Agency   @relation(fields: [agencyId], references: [id])
  isPrimaryAdmin Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([agencyId])
}

model ArtistProfile {
  id          String @id @default(cuid())
  ownerUserId String @unique
  owner       User   @relation("UserArtistProfile", fields: [ownerUserId], references: [id], onDelete: Cascade)

  // Current representing agency (always set — self-managed bands point at
  // their own auto-created tenant). `ownAgencyId` never changes after
  // creation, so "revert to self-managed" is always a one-field update.
  agencyId              String
  agency                Agency   @relation("AgencyArtists", fields: [agencyId], references: [id])
  ownAgencyId           String
  ownAgency             Agency   @relation("AgencySelfOwner", fields: [ownAgencyId], references: [id])
  commissionPctOverride Decimal? @db.Decimal(5, 2)

  bandSlug     String      @unique
  bandName     String
  bio          String?     @db.Text
  bioEn        String?     @db.Text
  genres       String[]
  city         String?
  region       String?
  country      String      @default("FI")
  minBudgetEur Int?
  maxBudgetEur Int?
  eventTypes   EventType[]

  spotifyUrl       String?
  youtubeUrl       String?
  websiteUrl       String?
  instagramUrl     String?
  heroImageUrl     String?
  galleryImageUrls String[]
  techRiderUrl     String?
  stagePlanUrl     String?

  approvalStatus ApprovalStatus @default(PENDING)
  isPublished    Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  members        BandMember[]
  bandInvites    BandInvite[]
  availability   AvailabilityEntry[]
  inquiries      InquiryRequest[]
  gigThreads     GigThread[]
  travelExpenses TravelExpense[]

  @@index([city, region])
  @@index([approvalStatus, isPublished])
  @@index([agencyId])
}

model BandMember {
  id                String        @id @default(cuid())
  artistProfileId   String
  artistProfile     ArtistProfile @relation(fields: [artistProfileId], references: [id], onDelete: Cascade)
  userId            String?
  user              User?         @relation(fields: [userId], references: [id])
  displayName       String
  instrument        String?
  payoutSharePct    Decimal?      @db.Decimal(5, 2)
  isOwner           Boolean       @default(false)
  canManageCalendar Boolean       @default(true)
  canLogExpenses    Boolean       @default(true)
  createdAt         DateTime      @default(now())

  travelExpenses TravelExpense[]

  @@index([artistProfileId])
}

model BandInvite {
  id              String    @id @default(cuid())
  artistProfileId String
  artistProfile   ArtistProfile @relation(fields: [artistProfileId], references: [id], onDelete: Cascade)
  email           String
  displayName     String
  instrument      String?
  token           String    @unique
  invitedByUserId String
  acceptedAt      DateTime?
  expiresAt       DateTime
  createdAt       DateTime  @default(now())

  @@index([artistProfileId])
}

model Venue {
  id        String   @id @default(cuid())
  name      String
  address   String?
  city      String?
  region    String?
  country   String   @default("FI")
  createdAt DateTime @default(now())

  availabilityEntries AvailabilityEntry[]
  inquiries           InquiryRequest[]
}

model ClientProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName  String
  phone     String?
  company   String?
  createdAt DateTime @default(now())

  inquiries InquiryRequest[]
}

model AvailabilityEntry {
  id              String        @id @default(cuid())
  artistProfileId String
  artistProfile   ArtistProfile @relation(fields: [artistProfileId], references: [id], onDelete: Cascade)
  type            AvailabilityType
  startDate       DateTime
  endDate         DateTime
  title           String?
  venueId         String?
  venue           Venue?          @relation(fields: [venueId], references: [id])
  relatedInquiryId String?        @unique
  relatedInquiry  InquiryRequest? @relation(fields: [relatedInquiryId], references: [id])
  notes           String?
  isPublicBusy    Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  travelExpenses TravelExpense[]

  @@index([artistProfileId, startDate, endDate])
}

model InquiryRequest {
  id              String         @id @default(cuid())
  artistProfileId String
  artistProfile   ArtistProfile  @relation(fields: [artistProfileId], references: [id], onDelete: Cascade)
  clientProfileId String?
  clientProfile   ClientProfile? @relation(fields: [clientProfileId], references: [id])

  contactName  String
  contactEmail String
  contactPhone String?

  eventType    EventType
  eventDate    DateTime
  eventCity    String?
  venueId      String?
  venue        Venue?   @relation(fields: [venueId], references: [id])
  guestCount   Int?
  budgetMinEur Int?
  budgetMaxEur Int?
  message      String?       @db.Text
  status       InquiryStatus @default(AWAITING_ARTIST_CONFIRMATION)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  quotes           Quote[]
  gigThread        GigThread?
  availabilityHold AvailabilityEntry?

  @@index([artistProfileId, status])
}

model Quote {
  id              String    @id @default(cuid())
  inquiryId       String
  inquiry         InquiryRequest @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  createdByUserId String
  amountEur       Int
  depositEur      Int?
  currency        String    @default("EUR")
  validUntil      DateTime?
  termsText       String?     @db.Text
  status          QuoteStatus @default(DRAFT)
  artistApprovedAt     DateTime?
  artistRejectionNote  String?   @db.Text
  sentAt          DateTime?
  respondedAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  transactions Transaction[]

  @@index([inquiryId, status])
}

model GigThread {
  id              String        @id @default(cuid())
  inquiryId       String        @unique
  inquiry         InquiryRequest @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  artistProfileId String
  artistProfile   ArtistProfile  @relation(fields: [artistProfileId], references: [id], onDelete: Cascade)
  isArchived      Boolean  @default(false)
  createdAt       DateTime @default(now())

  messages Message[]
}

model Message {
  id             String     @id @default(cuid())
  gigThreadId    String
  gigThread      GigThread  @relation(fields: [gigThreadId], references: [id], onDelete: Cascade)
  senderUserId   String?
  sender         User?      @relation(fields: [senderUserId], references: [id])
  senderRole     SenderRole
  body           String     @db.Text
  attachmentUrls String[]
  readAt         DateTime?
  createdAt      DateTime   @default(now())

  @@index([gigThreadId, createdAt])
}

// Provider-agnostic payment/escrow stub. Real Stripe/Paytrail/MobilePay wiring
// plugs into `provider` + `providerRef` later without a schema change.
model Transaction {
  id          String   @id @default(cuid())
  quoteId     String?
  quote       Quote?   @relation(fields: [quoteId], references: [id])
  purpose     PaymentPurpose
  provider    PaymentProviderType @default(MOCK)
  providerRef String?
  amountEur   Int
  currency    String        @default("EUR")
  status      PaymentStatus @default(PENDING)
  payerUserId String?
  payeeUserId String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([quoteId])
  @@index([status])
}

// Kilometers/receipts a band member logs against a gig. No approval step —
// members submit directly; agencies get read-only visibility for invoicing.
model TravelExpense {
  id              String   @id @default(cuid())
  artistProfileId String
  artistProfile   ArtistProfile @relation(fields: [artistProfileId], references: [id], onDelete: Cascade)
  bandMemberId    String
  bandMember      BandMember    @relation(fields: [bandMemberId], references: [id], onDelete: Cascade)

  availabilityEntryId String?
  availabilityEntry   AvailabilityEntry? @relation(fields: [availabilityEntryId], references: [id])

  expenseDate    DateTime
  startLocation  String?
  endLocation    String?
  kilometers     Decimal? @db.Decimal(8, 2)
  kmAllowanceEur Int?
  otherAmountEur Int?
  description    String?  @db.Text
  receiptUrl     String?
  status         ExpenseStatus @default(DRAFT)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([artistProfileId, status])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}
